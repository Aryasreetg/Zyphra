# Copy this file to .env.local for local development.
# On Netlify, set these under Site configuration → Environment variables.

# Postgres connection string. Needed for local development.
# On Netlify, the attached Netlify Database is picked up automatically,
# so you don't need to set this there.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Password for the admin panel at /admin
ADMIN_PASSWORD=change-me-to-something-long

# Optional: random string used to sign admin login cookies.
# Changing it logs the admin out everywhere. Defaults to ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=
